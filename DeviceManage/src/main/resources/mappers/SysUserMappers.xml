<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dmkj.system.user.mapper.SysUserMapper">

    <select id="isLogin" resultMap="Intger">
        SELECT count(username) FROM sys_user WHERE username = #{username} and password = #{password}
    </select>
</mapper>